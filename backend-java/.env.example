# Copy to backend-java/.env and fill in. NEVER commit backend-java/.env.
# `java -jar app.jar --rto.command=setup-mysql` (or scripts/setup-mysql) writes this file for you.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=
DB_PASSWORD=
DB_NAME=rto_management
TEST_DB_NAME=rto_management_test

# Generate with:  openssl rand -base64 64     (>= 32 characters)
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7

PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10

NOTIFICATION_PROVIDER=mock
PAYMENT_GATEWAY_KEY=

# Used only by `--rto.command=bootstrap` to create the first admin user.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=

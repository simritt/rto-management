---
title: Identity and access control
---
erDiagram
  persons {
    bigint person_id PK
    varchar first_name
    varchar last_name
    date date_of_birth
    varchar national_id_number UK
  }
  addresses {
    bigint address_id PK
    bigint person_id FK
    varchar line1
    varchar line2
    varchar city
  }
  citizens {
    bigint citizen_id PK
    bigint person_id FK, UK
    varchar citizen_code UK
    tinyint blacklisted
    varchar blacklist_reason
    timestamp registered_at
  }
  users {
    bigint user_id PK
    bigint person_id FK
    varchar username UK
    varchar password_hash
    datetime last_login_at
  }
  roles {
    bigint role_id PK
    varchar role_name UK
  }
  permissions {
    bigint permission_id PK
    varchar permission_key UK
  }
  user_roles {
    bigint user_id PK, FK
    bigint role_id PK, FK
  }
  role_permissions {
    bigint role_id PK, FK
    bigint permission_id PK, FK
  }
  persons ||--o{ addresses : "person_id"
  persons ||--o{ citizens : "person_id"
  permissions ||--o{ role_permissions : "permission_id"
  roles ||--o{ role_permissions : "role_id"
  roles ||--o{ user_roles : "role_id"
  users ||--o{ user_roles : "user_id"
  persons ||--o{ users : "person_id"
